# Swarm-Forge Orchestrator — environment configuration.
# Copy to .env and fill in real values. NEVER commit .env.

# ── Anthropic API ───────────────────────────────────────────────────────────
# Required. Used by the DAG planner (Opus 4.7), the RewardSwarmJudge
# (Sonnet 4.5), and Haiku 4.5 for routing/fallback.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# ── Runtime tuning ──────────────────────────────────────────────────────────
# Maximum parallel DAG workers inside the ThreadPoolExecutor. Scale with CPU.
SWARMFORGE_MAX_WORKERS=4

# Default per-node sandbox subprocess timeout (seconds).
SWARMFORGE_NODE_TIMEOUT_SEC=120

# Logging verbosity. One of: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# ── Stateful healing (HERMES) ───────────────────────────────────────────────
# Enable the post-failure skill synthesis retry loop. Set to 0 to disable.
SWARMFORGE_ENABLE_HEALING=1

# Max seconds to allocate to a single skill synthesis + retry cycle.
SWARMFORGE_HEALING_TIMEOUT_SEC=90

# ── AgentGuard (Layer 3 AST firewall) ───────────────────────────────────────
# Strict mode rejects any untrusted AST feature we cannot statically verify.
AGENTGUARD_STRICT=1

# ── Telemetry ───────────────────────────────────────────────────────────────
# OTel collector endpoint (reserved for future OTLP wire-protocol export).
OTEL_EXPORTER_OTLP_ENDPOINT=
